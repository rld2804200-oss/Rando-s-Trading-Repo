//@version=6  
// RanChann_1.0.9  
// Version History:  
// 1.0.9 - Added alerts for both previous and current channels  
// 1.0.8 - Added 2-channel display capability  
// 1.0.7 - Made tolerance value adjustable via input  
// 1.0.6 - Added 55-point tolerance for alert triggers  
// 1.0.5 - Removed timeframe input due to erratic results, reverted to current chart data  
// 1.0.4 - Added alert conditions for price breakouts and breakdowns  
// 1.0.3 - Simplified inputs: removed rLeft/rRight, renamed gLeft/gRight to leftExtension/rightExtension  
// 1.0.2 - Added auto-adjust pivot toggle by timeframe, added timeframe input for calculation  
// 1.0.1 - Initial version with green/red/mid channel lines  
indicator("RanChann_1.0.9", overlay=true, max_lines_count=500)  
  
// Pivot settings  
left = input.int(16, "Pivot Left")  
right = input.int(16, "Pivot Right")  
  
// Auto-adjust pivot toggle  
autoAdjustPivots = input.bool(false, "Auto-Adjust Pivots by Timeframe")  
  
// Extension settings  
leftExtension = input.int(5, "Left Extension")  
rightExtension = input.int(100, "Right Extension")  
  
// Tolerance setting  
tolerance = input.int(25, "Alert Tolerance (points)")  
  
// Alert toggles for current channel  
alertUpper = input.bool(true, "Alert on Upper Line (Current)")  
alertMid = input.bool(true, "Alert on Mid Line (Current)")  
alertLower = input.bool(true, "Alert on Lower Line (Current)") 
alertThreeQuarter = input.bool(false, "Alert on Three-Quarter Line (Current)")  
alertQuarter = input.bool(false, "Alert on Quarter Line (Current)")  

  
// Alert toggles for previous channel  
alertUpperPrev = input.bool(true, "Alert on Upper Line (Previous)")  
alertMidPrev = input.bool(true, "Alert on Mid Line (Previous)") 
alertLowerPrev = input.bool(true, "Alert on Lower Line (Previous)")  
alertThreeQuarterPrev = input.bool(false, "Alert on Three-Quarter Line (Previous)")  
alertQuarterPrev = input.bool(false, "Alert on Quarter Line (Previous)")  

// Pivot detection  
ph = ta.pivothigh(high, left, right)  
pl = ta.pivotlow(low, left, right)  
  
// Current channel pivot data  
var float l1y = na  
var int l1x = na  
var float l2y = na  
var int l2x = na  
var float hy = na  
var int hx = na  
  
// Previous channel pivot data  
var float prevL1y = na  
var int prevL1x = na  
var float prevL2y = na  
var int prevL2x = na  
var float prevHy = na  
var int prevHx = na  
  
// Slope and offset for current channel  
var float slope = na  
var float offset = na  
  
// Slope and offset for previous channel  
var float prevSlope = na  
var float prevOffset = na  
  
// Auto-adjust pivot legs based on timeframe  
tfInMinutes = timeframe.in_seconds() / 60  
adjustedLeft = autoAdjustPivots ? (tfInMinutes >= 1440 ? 20 : tfInMinutes >= 61 ? 20 : tfInMinutes == 60 ? 15 : tfInMinutes == 30 ? 9 : tfInMinutes == 15 ? 16 : tfInMinutes == 5 ? 12 : 5) : left    
adjustedRight = autoAdjustPivots ? adjustedLeft : right  
  
// Update current channel pivots  
if not na(pl)  
    l1y := l2y  
    l1x := l2x  
    l2y := pl  
    l2x := bar_index - adjustedRight  
  
if not na(ph)  
    hy := ph  
    hx := bar_index - adjustedRight  
  
// Calculate slope and offset for current channel  
if not na(l1y) and not na(l2y) and l1x != l2x  
    slope := (l2y - l1y) / (l2x - l1x)  
    if not na(hy)  
        lowerAtHx = l1y + slope * (hx - l1x)  
        offset := hy - lowerAtHx  
  
// Shift current to previous when new pivot forms  
if not na(pl) or not na(ph)  
    prevL1y := l1y  
    prevL1x := l1x  
    prevL2y := l2y  
    prevL2x := l2x  
    prevHy := hy  
    prevHx := hx  
    prevSlope := slope  
    prevOffset := offset  
  
// Line variables for current channel  
var line lower = na  
var line upper = na  
var line mid = na  
var line quarter = na  
var line threeQuarter = na  
  
// Line variables for previous channel  
var line prevLower = na  
var line prevUpper = na  
var line prevMid = na  
var line prevQuarter = na  
var line prevThreeQuarter = na  
  
// Compute channel values at current bar for alerts (current channel)  
upperValue = not na(slope) and not na(hy) ? hy + slope * (bar_index - hx) : na  
lowerValue = not na(slope) and not na(l1y) ? l1y + slope * (bar_index - l1x) : na  
midValue   = not na(slope) and not na(hy) and not na(offset) ? hy - offset / 2 + slope * (bar_index - hx) : na  
quarterValue = not na(slope) and not na(hy) and not na(offset) ? (hy - offset) + offset / 4 + slope * (bar_index - hx) : na  
threeQuarterValue = not na(slope) and not na(hy) and not na(offset) ? (hy - offset) + offset * 0.75 + slope * (bar_index - hx) : na  
  
// Compute channel values at current bar for alerts (previous channel)  
prevUpperValue = not na(prevSlope) and not na(prevHy) ? prevHy + prevSlope * (bar_index - prevHx) : na  
prevLowerValue = not na(prevSlope) and not na(prevL1y) ? prevL1y + prevSlope * (bar_index - prevL1x) : na  
prevMidValue   = not na(prevSlope) and not na(prevHy) and not na(prevOffset) ? prevHy - prevOffset / 2 + prevSlope * (bar_index - prevHx) : na  
prevQuarterValue = not na(prevSlope) and not na(prevHy) and not na(prevOffset) ? (prevHy - prevOffset) + prevOffset / 4 + prevSlope * (bar_index - prevHx) : na  
prevThreeQuarterValue = not na(prevSlope) and not na(prevHy) and not na(prevOffset) ? (prevHy - prevOffset) + prevOffset * 0.75 + prevSlope * (bar_index - prevHx) : na  
  
// Draw lines on last bar  
if barstate.islast and not na(l1y) and not na(l2y) and not na(hy) and l1x != l2x  
    // Delete old lines  
    line.delete(lower)  
    line.delete(upper)  
    line.delete(mid)  
    line.delete(quarter)  
    line.delete(threeQuarter)  
      
    // Current channel lines  
    gx1 = l1x - leftExtension  
    gy1 = l2y + slope * (gx1 - l2x)  
    gx2 = l2x + rightExtension  
    gy2 = l2y + slope * (gx2 - l2x)  
    lower := line.new(gx1, gy1, gx2, gy2, color=color.green, width=3)  
      
    rx1 = l1x - leftExtension  
    ry1 = hy + slope * (rx1 - hx)  
    rx2 = l2x + rightExtension  
    ry2 = hy + slope * (rx2 - hx)  
    upper := line.new(rx1, ry1, rx2, ry2, color=color.red, width=3)  
      
    lowerAtHx = l1y + slope * (hx - l1x)  
    offset = hy - lowerAtHx  
    midY = hy - offset / 2  
    mx1 = l1x - leftExtension  
    my1 = midY + slope * (mx1 - hx)  
    mx2 = l2x + rightExtension  
    my2 = midY + slope * (mx2 - hx)  
    mid := line.new(mx1, my1, mx2, my2, color=color.white, width=2, style=line.style_dashed)  
      
    qy1 = (hy - offset) + offset / 4 + slope * (mx1 - hx)  
    qy2 = (hy - offset) + offset / 4 + slope * (mx2 - hx)  
    quarter := line.new(mx1, qy1, mx2, qy2, color=color.yellow, width=2, style=line.style_dotted)  
      
    tqy1 = (hy - offset) + offset * 0.75 + slope * (mx1 - hx)  
    tqy2 = (hy - offset) + offset * 0.75 + slope * (mx2 - hx)  
    threeQuarter := line.new(mx1, tqy1, mx2, tqy2, color=color.yellow, width=2, style=line.style_dotted)  
      
    // Previous channel lines (if exists)  
    if not na(prevL1y) and not na(prevL2y) and not na(prevHy) and prevL1x != prevL2x  
        line.delete(prevLower)  
        line.delete(prevUpper)  
        line.delete(prevMid)  
        line.delete(prevQuarter)  
        line.delete(prevThreeQuarter)  
          
        pgx1 = prevL1x - leftExtension  
        pgy1 = prevL2y + prevSlope * (pgx1 - prevL2x)  
        pgx2 = prevL2x + rightExtension  
        pgy2 = prevL2y + prevSlope * (pgx2 - prevL2x)  
        prevLower := line.new(pgx1, pgy1, pgx2, pgy2, color=color.new(color.green, 70), width=2)  
          
        prx1 = prevL1x - leftExtension  
        pry1 = prevHy + prevSlope * (prx1 - prevHx)  
        prx2 = prevL2x + rightExtension  
        pry2 = prevHy + prevSlope * (prx2 - prevHx)  
        prevUpper := line.new(prx1, pry1, prx2, pry2, color=color.new(color.red, 70), width=2)  
          
        plowerAtHx = prevL1y + prevSlope * (prevHx - prevL1x)  
        poffset = prevHy - plowerAtHx  
        pmidY = prevHy - poffset / 2  
        pmx1 = prevL1x - leftExtension  
        pmy1 = pmidY + prevSlope * (pmx1 - prevHx)  
        pmx2 = prevL2x + rightExtension  
        pmy2 = pmidY + prevSlope * (pmx2 - prevHx)  
        prevMid := line.new(pmx1, pmy1, pmx2, pmy2, color=color.new(color.white, 70), width=1, style=line.style_dashed)  
          
        pqy1 = (prevHy - poffset) + poffset / 4 + prevSlope * (pmx1 - prevHx)  
        pqy2 = (prevHy - poffset) + poffset / 4 + prevSlope * (pmx2 - prevHx)  
        prevQuarter := line.new(pmx1, pqy1, pmx2, pqy2, color=color.new(color.yellow, 70), width=1, style=line.style_dotted)  
          
        ptqy1 = (prevHy - poffset) + poffset * 0.75 + prevSlope * (pmx1 - prevHx)  
        ptqy2 = (prevHy - poffset) + poffset * 0.75 + prevSlope * (pmx2 - prevHx)  
        prevThreeQuarter := line.new(pmx1, ptqy1, pmx2, ptqy2, color=color.new(color.yellow, 70), width=1, style=line.style_dotted)  
  
// Alert conditions for current channel  
alertcondition(alertUpper and ta.crossover(close, upperValue + tolerance), title="Upper Breakout (Current)", message="Price broke above upper channel with tolerance")  
alertcondition(alertUpper and ta.crossunder(close, upperValue - tolerance), title="Upper Breakdown (Current)", message="Price broke below upper channel with tolerance")  
alertcondition(alertLower and ta.crossover(close, lowerValue + tolerance), title="Lower Breakout (Current)", message="Price broke above lower channel with tolerance")  
alertcondition(alertLower and ta.crossunder(close, lowerValue - tolerance), title="Lower Breakdown (Current)", message="Price broke below lower channel with tolerance")  
alertcondition(alertMid and ta.crossover(close, midValue + tolerance), title="Mid Cross Up (Current)", message="Price crossed above midline with tolerance")  
alertcondition(alertMid and ta.crossunder(close, midValue - tolerance), title="Mid Cross Down (Current)", message="Price crossed below midline with tolerance")  
alertcondition(alertQuarter and ta.crossover(close, quarterValue + tolerance), title="Quarter Cross Up (Current)", message="Price crossed above 25% line with tolerance")  
alertcondition(alertQuarter and ta.crossunder(close, quarterValue - tolerance), title="Quarter Cross Down (Current)", message="Price crossed below 25% line with tolerance")  
alertcondition(alertThreeQuarter and ta.crossover(close, threeQuarterValue + tolerance), title="Three-Quarter Cross Up (Current)", message="Price crossed above 75% line with tolerance")  
alertcondition(alertThreeQuarter and ta.crossunder(close, threeQuarterValue - tolerance), title="Three-Quarter Cross Down (Current)", message="Price crossed below 75% line with tolerance")  
  
// Alert conditions for previous channel  
alertcondition(alertUpperPrev and ta.crossover(close, prevUpperValue + tolerance), title="Upper Breakout (Previous)", message="Price broke above upper channel (previous) with tolerance")  
alertcondition(alertUpperPrev and ta.crossunder(close, prevUpperValue - tolerance), title="Upper Breakdown (Previous)", message="Price broke below upper channel (previous) with tolerance")  
alertcondition(alertLowerPrev and ta.crossover(close, prevLowerValue + tolerance), title="Lower Breakout (Previous)", message="Price broke above lower channel (previous) with tolerance")  
alertcondition(alertLowerPrev and ta.crossunder(close, prevLowerValue - tolerance), title="Lower Breakdown (Previous)", message="Price broke below lower channel (previous) with tolerance")  
alertcondition(alertMidPrev and ta.crossover(close, prevMidValue + tolerance), title="Mid Cross Up (Previous)", message="Price crossed above midline (previous) with tolerance")  
alertcondition(alertMidPrev and ta.crossunder(close, prevMidValue - tolerance), title="Mid Cross Down (Previous)", message="Price crossed below midline (previous) with tolerance")  
alertcondition(alertQuarterPrev and ta.crossover(close, prevQuarterValue + tolerance), title="Quarter Cross Up (Previous)", message="Price crossed above 25% line (previous) with tolerance")  
alertcondition(alertQuarterPrev and ta.crossunder(close, prevQuarterValue - tolerance), title="Quarter Cross Down (Previous)", message="Price crossed below 25% line (previous) with tolerance")  
alertcondition(alertThreeQuarterPrev and ta.crossover(close, prevThreeQuarterValue + tolerance), title="Three-Quarter Cross Up (Previous)", message="Price crossed above 75% line (previous) with tolerance")  
alertcondition(alertThreeQuarterPrev and ta.crossunder(close, prevThreeQuarterValue - tolerance), title="Three-Quarter Cross Down (Previous)", message="Price crossed below 75% line (previous) with tolerance")  
  
// Required plot for script validation (hidden)  
plot(na, display = display.none)
