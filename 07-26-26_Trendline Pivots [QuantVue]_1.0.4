//@version=6  
indicator("07-26-26_Trendline Pivots [QuantVue]_1.0.4", overlay = true)  
  
//inputs  
dtlColor            = input.color(color.red, 'Down Trend Line Color', inline = '0')  
utlColor            = input.color(color.green, 'Up Trend Line Color', inline = '1')  
pastColor           = input.color(color.orange, 'Crossed Line Color', inline = '2')  
extendLine          = input.bool(false, 'Extend Lines Until Crossed', inline = '3')  
onlyLast            = input.bool(false, 'Most Recent Line Only', inline = '3', tooltip = 'If multiple lines share pivot points, checking this will only show the most recent line.')  
hideCrossed         = input.bool(false, 'Hide Crossed Lines', inline = '4')  
showCross           = input.bool(true, 'Show Crosses', inline ='4', tooltip = 'Hiding crossed lines will only leave trend lines on the chart that have not been breached by your selected source. Showing crosses will plot an "X" where price crosses the trendline based on your selected source.')  
crossDown           = input.color(color.red, 'Cross Below Color', inline = '5')  
crossUp             = input.color(color.lime, 'Cross Above Color', inline = '5')  
maxLines            = input.int(2, 'Max Number of Crossed Lines to Show of each', step = 2, minval = 0, maxval = 50)  
crossSrc            = input.string('Close', 'Cross Source', options = ['Close', 'High/Low'])  
maxLineLen          = input.int(252, 'Max Line Length', tooltip = 'Will remove line if it is not crossed after selected amount of bars')  
pivLen              = input.int(9, 'Pivot Length', step = 1, minval = 1)  
crossesBeforeDash   = input.int(3, "Crosses Before Dotted", minval = 1)  
barsToDotted        = input.int(50, "Bars To Dotted (if never crossed)", minval = 1)  
maxLines            := hideCrossed ? 0 : maxLines  
isLog               = input.bool(false, 'Log Scale', tooltip = 'Select this option if using a log chart.')  
  
type pivot  
    string pivType  
    int x1  
    float y1  
    int x2  
    float y2  
  
// arrays  
var line[] dtlArray = array.new_line()  
var line[] utlArray = array.new_line()  
var int[]  utlCrossCount = array.new_int()  
var int[]  dtlCrossCount = array.new_int()  
var int[]  utlBirthBar = array.new_int()  
var int[]  dtlBirthBar = array.new_int()  
var line[] dashedUtl = array.new_line()  
var line[] dashedDtl = array.new_line()  
  
// alert flags  
var bool utlCrossed = false  
var bool dtlCrossed = false  
  
//functions  
createLine(ptype, x1, y1, x2, y2)=>  
    piv = pivot.new(ptype, x1, y1, x2, y2)  
    trendline = line.new(x1, y1, x2, y2, extend = extendLine ? extend.right : extend.none, color = ptype == 'ph' ? dtlColor : utlColor, width = 2)  
    if ptype == 'ph'  
        dtlArray.unshift(trendline)  
        dtlCrossCount.unshift(0)  
        dtlBirthBar.unshift(bar_index)  
    else if ptype == 'pl'  
        utlArray.unshift(trendline)  
        utlCrossCount.unshift(0)  
        utlBirthBar.unshift(bar_index)  
    piv  
  
getSlope(l)=>  
    (line.get_y2(l) - line.get_y1(l)) / (line.get_x2(l) - line.get_x1(l))  
  
getSlopeLog(l)=>  
    slope = (math.log(line.get_y2(l)) - math.log(line.get_y1(l))) / (line.get_x2(l) - line.get_x1(l))  
    math.exp(math.log(line.get_y2(l)) - slope * (line.get_x2(l) - bar_index))  
  
// variables  
ph = ta.pivothigh(high, pivLen, pivLen)  
pl = ta.pivotlow(low, pivLen, pivLen)  
var int utlX1 = na, var float utlY1 = na  
var int utlX2 = na, var float utlY2 = na  
var int dtlX1 = na, var float dtlY1 = na  
var int dtlX2 = na, var float dtlY2 = na  
  
utlCrossed := false  
dtlCrossed := false  
  
if not na(pl)  
    utlX1 := utlX2  
    utlY1 := utlY2  
    utlX2 := bar_index[pivLen]  
    utlY2 := low[pivLen]  
    if not na(utlY1) and utlY1 < utlY2  
        createLine('pl', utlX1, utlY1, utlX2, utlY2)  
  
if not na(ph)  
    dtlX1 := dtlX2  
    dtlY1 := dtlY2  
    dtlX2 := bar_index[pivLen]  
    dtlY2 := high[pivLen]  
    if not na(dtlY1) and dtlY1 > dtlY2  
        createLine('ph', dtlX1, dtlY1, dtlX2, dtlY2)  
  
// UTL  
if utlArray.size() > 0  
    for i = utlArray.size() - 1 to 0  
        l = utlArray.get(i)  
        src = crossSrc == 'Close' ? close : low  
        prevSrc = crossSrc == 'Close' ? close[1] : low[1]  
        extended = not isLog ? line.get_y2(l) - getSlope(l) * (line.get_x2(l) - bar_index) : getSlopeLog(l)  
        line.set_xy2(l, bar_index, extended)  
  
        first = i == 0  
        if line.get_x2(l) - line.get_x1(l) > maxLineLen  
            line.delete(l)  
            array.remove(utlArray, i)  
            array.remove(utlCrossCount, i)  
            array.remove(utlBirthBar, i)  
            continue  
  
        if src > line.get_price(l, bar_index) and not first and onlyLast  
            line.delete(l)  
            array.remove(utlArray, i)  
            array.remove(utlCrossCount, i)  
            array.remove(utlBirthBar, i)  
            continue  
  
        linePrice = line.get_price(l, bar_index)  
        prevPrice = line.get_price(l, bar_index - 1)  
        crossed = (prevSrc >= prevPrice and src < linePrice)  
  
        if crossed  
            cnt = utlCrossCount.get(i) + 1  
            utlCrossCount.set(i, cnt)  
            utlCrossed := true  
            if showCross  
                label.new(bar_index, low, ' ', yloc = yloc.belowbar, color = crossDown, style = label.style_xcross, size = size.tiny)  
              
            // Enhanced alert with trendline identification  
            string alertMsg = str.tostring(syminfo.ticker) + " Cross Under Trendline #" + str.tostring(i) +   
                             " | Price: " + str.tostring(linePrice, format.mintick) +   
                             " | Line: " + str.tostring(line.get_x1(l)) + "," + str.tostring(line.get_y1(l)) +   
                             " to " + str.tostring(line.get_x2(l)) + "," + str.tostring(line.get_y2(l)) +  
                             " | Age: " + str.tostring(bar_index - utlBirthBar.get(i)) + " bars" +  
                             " | Cross #" + str.tostring(cnt)  
            alert(alertMsg, alert.freq_once_per_bar)  
  
        age = bar_index - utlBirthBar.get(i)  
        if utlCrossCount.get(i) >= crossesBeforeDash or age >= barsToDotted  
            newLine = line.new(line.get_x1(l), line.get_y1(l), line.get_x2(l), line.get_y2(l), color = pastColor, style = line.style_dashed, width = 1)  
            dashedUtl.unshift(newLine)  
            line.delete(l)  
            array.remove(utlArray, i)  
            array.remove(utlCrossCount, i)  
            array.remove(utlBirthBar, i)  
  
// DTL  
if dtlArray.size() > 0  
    for i = dtlArray.size() - 1 to 0  
        l = dtlArray.get(i)  
        src = crossSrc == 'Close' ? close : high  
        prevSrc = crossSrc == 'Close' ? close[1] : high[1]  
        extended = not isLog ? line.get_y2(l) - getSlope(l) * (line.get_x2(l) - bar_index) : getSlopeLog(l)  
        line.set_xy2(l, bar_index, extended)  
  
        first = i == 0  
        if line.get_x2(l) - line.get_x1(l) > maxLineLen  
            line.delete(l)  
            array.remove(dtlArray, i)  
            array.remove(dtlCrossCount, i)  
            array.remove(dtlBirthBar, i)  
            continue  
  
        if src < line.get_price(l, bar_index) and not first and onlyLast  
            line.delete(l)  
            array.remove(dtlArray, i)  
            array.remove(dtlCrossCount, i)  
            array.remove(dtlBirthBar, i)  
            continue  
  
        linePrice = line.get_price(l, bar_index)  
        prevPrice = line.get_price(l, bar_index - 1)  
        crossed = (prevSrc <= prevPrice and src > linePrice)  
  
        if crossed  
            cnt = dtlCrossCount.get(i) + 1  
            dtlCrossCount.set(i, cnt)  
            dtlCrossed := true  
            if showCross  
                label.new(bar_index, high, '', yloc = yloc.abovebar, style = label.style_xcross, color = crossUp, size = size.tiny)  
              
            // Enhanced alert with trendline identification  
            string alertMsg = str.tostring(syminfo.ticker) + " Cross Over Trendline #" + str.tostring(i) +   
                             " | Price: " + str.tostring(linePrice, format.mintick) +   
                             " | Line: " + str.tostring(line.get_x1(l)) + "," + str.tostring(line.get_y1(l)) +   
                             " to " + str.tostring(line.get_x2(l)) + "," + str.tostring(line.get_y2(l)) +  
                             " | Age: " + str.tostring(bar_index - dtlBirthBar.get(i)) + " bars" +  
                             " | Cross #" + str.tostring(cnt)  
            alert(alertMsg, alert.freq_once_per_bar)  
  
        age = bar_index - dtlBirthBar.get(i)  
        if dtlCrossCount.get(i) >= crossesBeforeDash or age >= barsToDotted  
            newLine = line.new(line.get_x1(l), line.get_y1(l), line.get_x2(l), line.get_y2(l), color = pastColor, style = line.style_dashed, width = 1)  
            dashedDtl.unshift(newLine)  
            line.delete(l)  
            array.remove(dtlArray, i)  
            array.remove(dtlCrossCount, i)  
            array.remove(dtlBirthBar, i)  
  
// limit dashed  
while dashedUtl.size() > maxLines  
    line.delete(dashedUtl.pop())  
while dashedDtl.size() > maxLines  
    line.delete(dashedDtl.pop())  
  
// named alerts  
alertcondition(utlCrossed, title="Cross Under Trendline", message="{{ticker}} Cross Under Trendline")  
alertcondition(dtlCrossed, title="Cross Over Trendline", message="{{ticker}} Cross Over Trendline")  
alertcondition(utlCrossed or dtlCrossed, title="Trendline Cross", message="{{ticker}} Trendline Cross")
